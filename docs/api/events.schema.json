        "after_message_count": {
          "type": "number"
        },
        "before_message_count": {
          "type": "number"
        },
        "chat_id": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        },
        "summary_chars": {
          "type": "number"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "after_message_count",
        "before_message_count",
        "source",
        "success",
        "summary_chars",
        "timestamp"
      ],
      "type": "object"
    },
    "CompactStartedData": {
      "description": "Payload for compact_started (seed structural compaction / manual /compact).",
      "properties": {
        "chat_id": {
          "type": "string"
        },
        "checkpoint_count": {
          "type": "number"
        },
        "message_count": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "checkpoint_count",
        "message_count",
        "source",
        "timestamp"
      ],
      "type": "object"
    },
    "ConnectionStatusData": {
      "properties": {
        "client_id": {
          "type": "string"
        },
        "connected": {
          "type": "boolean"
        },
        "message_count": {
          "type": "number"
        },
        "queuedMessageCount": {
          "type": "number"
        },
        "reattach": {
          "type": [
            "string",
            "null"
          ]
        },
        "reconnected": {
          "type": "boolean"
        },
        "reconnecting": {
          "type": "boolean"
        },
        "restored": {
          "type": "boolean"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "connected"
      ],
      "type": "object"
    },
    "ContextManagementDiagnosticData": {
      "description": "Per-iteration context-management diagnostic emitted by the backend agent loop (see pkg/events.ContextManagementDiagnosticEvent). The fields mirror the Go payload 1:1 — `cached_tokens`, `prompt_tokens`, and `cache_write_tokens` are cumulative session counters (not per-iteration), and `cache_hit_rate` is the backend-computed `cached/prompt` ratio. The frontend treats this as telemetry: the typed payload lets the dedicated handler in useWebSocketEventHandler render a compact summary instead of letting the event fall through to the generic \"unknown event\" branch and show up as raw JSON in the Logs pane.",
      "properties": {
        "cache_hit_rate": {
          "type": "number"
        },
        "cache_write_tokens": {
          "type": "number"
        },
        "cached_tokens": {
          "type": "number"
        },
        "chat_id": {
          "type": "string"
        },
        "current_tokens": {
          "type": "number"
        },
        "effective_max": {
          "type": "number"
        },
        "iteration": {
          "type": "number"
        },
        "max_tokens": {
          "type": "number"
        },
        "message_count": {
          "type": "number"
        },
        "native_max_tokens": {
          "type": "number"
        },
        "prompt_tokens": {
          "type": "number"
        },
        "reserved_response": {
          "type": "number"
        },
        "reserved_thinking": {
          "type": "number"
        },
        "reserved_tool_io": {
          "type": "number"
        },
        "trigger_fraction": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "DelegateClarificationRequestedData": {
      "properties": {
        "chat_id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "subagent_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "question",
        "request_id",
        "subagent_id",
        "timestamp"
      ],
      "type": "object"
    },
    "DelegateClarificationRespondedData": {
      "properties": {
        "chat_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "response": {
