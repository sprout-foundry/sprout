{
  "name": "@sprout-foundry/workspace",
  "version": "1.0.0",
  "description": "Composition API for Sprout — the workspace, its spaces and views, for hosts that embed them",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/sprout-foundry/sprout.git",
    "directory": "packages/workspace"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/views.js",
    "dist/views.d.ts",
    "dist/providers.js",
    "dist/providers.d.ts",
    "dist/design.js",
    "dist/workspace.css",
    "dist/wasm/",
    "dist/chunks/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "import": "./dist/views.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "import": "./dist/providers.js"
    },
    "./styles.css": "./dist/workspace.css",
    "./wasm/": "./dist/wasm/"
  },
  "scripts": {
    "build": "vite build && node scripts/scope-stylesheet.mjs && node scripts/bundle-dts.mjs && node scripts/emit-wasm-assets.mjs && node --test scripts/emit-wasm-assets.test.mjs",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.7",
    "@sprout/events": "file:../events",
    "@sprout/ui": "file:../ui",
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
