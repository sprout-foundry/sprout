        "options": {
          "items": {
            "$ref": "#/$defs/AskUserRequestOption"
          },
          "type": "array"
        },
        "question": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "sensitive": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        }
