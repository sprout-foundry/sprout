        "timestamp"
      ],
      "type": "object"
    },
    "LanguageGuardReplacementData": {
      "description": "Payload for a language_guard_replacement event (SP-152 §152c, item 152.7). Published when a streamed reply that was RELEASED by the streaming hold-back (its start passed the language check) is re-checked at completion and found to have switched language mid-stream. The reply was already streamed to the client and cannot be un-streamed, so the WebUI replaces the already-streamed assistant message's content with `replacement` and keeps `original` (the full switched content) available for \"view original\". Go: pkg/events.events_filter.go::LanguageGuardReplacementEvent",
      "properties": {
        "chat_id": {
          "type": "string"
        },
        "original": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        }
      },
      "required": [
        "original",
        "reason",
        "replacement"
      ],
      "type": "object"
    },
    "MetricsUpdateData": {
      "properties": {
        "chat_id": {
          "type": "string"
        },
        "context_tokens": {
          "type": "number"
        },
        "iteration": {
          "type": "number"
        },
        "max_context_tokens": {
          "type": "number"
        },
        "model": {
          "type": "string"
        },
        "persona": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "total_cost": {
          "type": "number"
        },
        "total_tokens": {
