{
  "persist_runtime_overrides": false,
  "progress": {
    "heartbeat_seconds": 600
  },
  "budget": {
      "warn_at": [
      0.5,
      0.8
    ],
    "on_exceed": "truncate",
    "usd": 10
  },
    "continue_on_error": true,
    "description": "Processes TODO.md items one at a time with full build/test/review cycle, then commits each. Coordinator/orchestrator use DeepSeek V4 Flash; subagents use qwen3.6-27b via ai-worker.",
    "initial": {
    "risk_profile": "permissive",
    "skip_prompt": true,
    "subagent_overrides": {
    "coder": {
    "provider": "ai-worker",
    "model": "qwen3.6-27b-b"
    },
      "debugger": {
      "model": "qwen3.6-27b-b",
      "provider": "ai-worker"
    },
      "orchestrator": {
      "model": "deepseek-v4-flash",
      "provider": "deepseek"
    },
      "reviewer": {
      "model": "qwen3.6-27b-b",
      "provider": "ai-worker"
    },
      "tester": {
      "model": "qwen3.6-27b-b",
      "provider": "ai-worker"
    }
  },
    "max_iterations": 0,
    "model": "deepseek-v4-flash",
    "persona": "coordinator",
    "prompt_file": "automate/workflow_prompt.md",
    "provider": "deepseek"
  },
  "no_web_ui": true
}
