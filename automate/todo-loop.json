{
  "budget": {
  "usd": 10,
  "warn_at": [
  0.5,
  0.8
],
  "on_exceed": "truncate"
},
  "description": "Lightweight TODO loop runner — stateless gate call parses each TODO item, orchestrator executes with context reset between items.",
  "initial": {
  "skip_prompt": true,
  "subagent_overrides": {
  "coder": {
  "model": "qwen3.6-27b",
  "provider": "ai-worker"
},
  "debugger": {
  "model": "qwen3.6-27b",
  "provider": "ai-worker"
},
  "orchestrator": {
  "provider": "deepseek",
  "model": "deepseek-v4-flash"
},
  "reviewer": {
  "model": "qwen3.6-27b",
  "provider": "ai-worker"
},
  "tester": {
  "provider": "ai-worker",
  "model": "qwen3.6-27b"
}
},
  "model": "deepseek-v4-flash",
  "persona": "orchestrator",
  "provider": "deepseek",
  "risk_profile": "permissive"
},
  "loop": {
  "max_retries": 2,
  "todo_file": "TODO.md",
  "build_command": "go build ./...",
  "gate_prompt_file": "automate/todo_loop_gate.md",
  "max_iterations": 50
},
  "orchestration": {
  "enabled": true,
  "resume": true
},
  "persist_runtime_overrides": false,
  "continue_on_error": true,
  "no_web_ui": true,
  "progress": {
  "heartbeat_seconds": 300
}
}