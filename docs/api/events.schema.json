{
  "$defs": {
    "AgentMessageData": {
      "properties": {
        "action": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "category",
        "message"
      ],
      "type": "object"
    },
    "AskUserRequestData": {
      "properties": {
        "client_id": {
          "type": "string"
        },
