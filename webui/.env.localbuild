# Local mode (for build-webui-dist local builds)
#
# WHY the mode name is "localbuild" instead of "local":
#   Vite 6.4.x rejects the mode name "local" because it collides with the
#   .env.local suffix convention (loadEnv throws). This mode name is purely a
#   Vite build tag; the actual app mode is still VITE_SPROUT_MODE=local below.
#   .env.local remains available for developer machine-specific overrides
#   (it is gitignored).
VITE_SPROUT_MODE=local
