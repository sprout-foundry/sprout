          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "type": "object"
    },
    "CommandOutputData": {
      "description": "Streamed output from a safe slash command.",
      "properties": {
        "chat_id": {
          "type": "string"
        },
        "chunk": {
          "type": "string"
        },
        "command": {
          "type": "string"
