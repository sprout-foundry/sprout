        "command": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "command",
        "prompt",
        "request_id",
        "timestamp"
      ],
      "type": "object"
    },
    "ProgressCompleteData": {
      "description": "Payload for a progress_complete event: the run finished. `verified` is true only when a passing verification result exists (SP-149 §149d / SP-151 §151c). `not_verified_reason` says why only when verification is enabled and the turn was not verified (e.g. \"no code changes this turn\"); when SP-149 is disabled (the CLI default) both `verification` and `not_verified_reason` are absent — the payload carries just `run_id`, so the default UI is unchanged. Go: pkg/events/progress_events.go::ProgressCompleteData",
      "properties": {
        "not_verified_reason": {
          "type": "string"
        },
        "plan_revision": {
          "type": "number"
        },
        "run_id": {
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/ProgressVerificationData"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "plan_revision",
        "run_id"
      ],
      "type": "object"
    },
    "ProgressMilestoneData": {
      "description": "Payload for a progress_milestone event: a plan scope item (SP-148) started or finished, with the files-touched count and the scope item's elapsed wall time. Go: pkg/events/progress_events.go::ProgressMilestoneData",
      "properties": {
        "elapsed_ms": {
          "type": "number"
        },
        "files_touched": {
          "type": "number"
        },
        "milestones": {
          "items": {
            "$ref": "#/$defs/ProgressMilestoneData"
          },
          "type": "array"
        },
        "phase": {
          "type": "string"
        },
        "plan_revision": {
          "type": "number"
        },
        "run_id": {
          "type": "string"
        },
        "scope_id": {
          "type": "string"
        },
        "scope_title": {
          "type": "string"
        }
      },
      "required": [
        "elapsed_ms",
        "phase",
        "plan_revision",
        "run_id"
      ],
      "type": "object"
    },
    "ProgressQuestionData": {
      "description": "Payload for a progress_question event: the agent needs a decision. Carries the question, options if any, and why it matters — complementing `ask_user_request` with plan context. Go: pkg/events/progress_events.go::ProgressQuestionData",
      "properties": {
        "header": {
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/AskUserRequestOption"
          },
          "type": "array"
        },
        "plan_revision": {
          "type": "number"
        },
        "question": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "scope_id": {
          "type": "string"
        },
        "why_it_matters": {
          "type": "string"
        }
      },
      "required": [
        "plan_revision",
        "question",
        "run_id"
      ],
      "type": "object"
    },
    "ProgressVerificationCheck": {
      "description": "Compact evidence a single verification check carries (SP-149). Mirrors the consumer-facing fields of verify.Check; the full result (routes, screenshots, steps, duration) stays server-side. Go: pkg/events/progress_events.go::ProgressVerificationCheck",
      "properties": {
        "command": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "skipped": {
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ProgressVerificationData": {
      "description": "Payload for a progress_verification event: the SP-149 verification result — the checks, pass/fail, and evidence references. Go: pkg/events/progress_events.go::ProgressVerificationData",
      "properties": {
        "baseline": {
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ProgressVerificationCheck"
          },
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "passed": {
          "type": "boolean"
        },
        "plan_revision": {
          "type": "number"
        },
        "run_id": {
          "type": "string"
        }
      },
      "required": [
        "checks",
        "plan_revision",
        "run_id"
      ],
      "type": "object"
    },
