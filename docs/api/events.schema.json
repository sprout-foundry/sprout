          "type": "number"
        },
        "lines_deleted": {
          "type": "number"
        },
        "operation": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "size": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "FileContentChangedData": {
      "properties": {
