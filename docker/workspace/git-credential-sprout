#!/bin/sh
# git credential helper for the sprout workspace image.
#
# Returns SPROUT_GIT_TOKEN only to the host it was issued for: protocol must
# be https and the host must equal SPROUT_GIT_HOST (default github.com), so
# the token never reaches another server a repository points at. SSH remotes
# get nothing; a token is never a valid SSH credential. git reaches this
# helper through `credential.helper sprout`, which the entrypoint sets.
set -eu

[ "${1:-}" = get ] || exit 0

host=""
protocol=""
while IFS= read -r line && [ -n "$line" ]; do
    case "$line" in
        host=*) host=${line#host=} ;;
        protocol=*) protocol=${line#protocol=} ;;
    esac
done

[ "$protocol" = https ] || exit 0
[ -n "${SPROUT_GIT_TOKEN:-}" ] || exit 0
allowed_host=${SPROUT_GIT_HOST:-github.com}
[ -n "$host" ] && [ "$host" = "$allowed_host" ] || exit 0

if [ "$allowed_host" = github.com ]; then
    username=x-access-token
else
    username=oauth2
fi
printf 'username=%s\npassword=%s\n' "$username" "$SPROUT_GIT_TOKEN"
