      "type": "object"
    },
    "EventsProvider": {
      "description": "EventsProvider — abstraction over the real-time event transport. In local mode this wraps a WebSocket connection to the Go backend. In cloud mode this could wrap Server-Sent Events, a cloud WebSocket, or any other streaming transport. Components consume this via the `useEvents()` hook from EventsContext.",
      "type": "object"
    },
    "FileChangedData": {
      "properties": {
        "action": {
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "file_path": {
          "type": "string"
        },
