{
  "budget": {
    "on_exceed": "truncate",
    "usd": 10,
    "warn_at": [
      0.5,
      0.8
    ]
  },
  "continuation": {
    "todo_file": "TODO.md"
  },
  "continue_on_error": true,
  "description": "Processes TODO.md items one at a time with full build/test/review cycle, then commits each. Coordinator/orchestrator use DeepSeek V4 Flash; subagents use glm-5.3-flash via zai-coding.",
  "initial": {
    "allowed_paths": [
      {
        "mode": "read_only",
        "path": "/api",
        "reason": "API route strings in search patterns (e.g. grep \"/api/git/\"); not a filesystem path"
      }
    ],
    "max_iterations": 10000,
    "model": "deepseek-ai/DeepSeek-V4.1-Flash",
    "persona": "coordinator",
    "prompt_file": "automate/workflow_prompt.md",
    "provider": "deepinfra",
    "risk_profile": "unrestricted",
    "skip_prompt": true,
    "subagent_overrides": {
      "debugger": {
        "model": "deepseek-ai/DeepSeek-V4.1-Flash",
        "provider": "deepinfra"
      },
      "orchestrator": {
        "model": "deepseek-ai/DeepSeek-V4.1-Flash",
        "provider": "deepinfra"
      },
      "reviewer": {
        "model": "deepseek-ai/DeepSeek-V4.1-Flash",
        "provider": "deepinfra"
      }
    }
  },
  "no_web_ui": true,
  "persist_runtime_overrides": false,
  "progress": {
    "heartbeat_seconds": 600
  },
  "subagent_timeout_seconds": 10800,
  "unsafe": true
}
