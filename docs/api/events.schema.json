      "required": [
        "request_id",
        "response",
        "subagent_id",
        "timestamp"
      ],
      "type": "object"
    },
    "EditApprovalRequestData": {
      "description": "Payload for an edit_approval_request event (SP-072-3).",
      "properties": {
        "file_path": {
          "type": "string"
        },
        "hunks": {
          "items": {
            "$ref": "#/$defs/EditHunk"
          },
          "type": "array"
        },
        "request_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "unified_diff": {
          "type": "string"
        }
      },
      "required": [
        "file_path",
        "hunks",
        "request_id"
      ],
      "type": "object"
    },
    "EditHunk": {
      "description": "A discrete change region in a unified diff for edit approval.",
      "properties": {
        "add_count": {
          "type": "number"
        },
        "del_count": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/EditHunkLine"
          },
          "type": "array"
        },
        "new_lines": {
          "type": "number"
        },
        "new_start": {
          "type": "number"
        },
        "old_lines": {
          "type": "number"
        },
        "old_start": {
          "type": "number"
        }
      },
      "required": [
        "add_count",
        "del_count",
        "id",
        "lines",
        "new_lines",
        "new_start",
        "old_lines",
        "old_start"
      ],
      "type": "object"
    },
    "EditHunkLine": {
      "description": "A single line in a diff hunk with its change type.",
      "properties": {
        "content": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "content",
        "type"
      ],
      "type": "object"
    },
    "ErrorData": {
      "properties": {
        "chat_id": {
          "type": "string"
        },
        "code": {
