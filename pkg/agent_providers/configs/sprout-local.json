{
  "streaming": {
  "chunk_timeout_ms": 120000,
  "done_marker": "[DONE]",
  "format": "sse"
},
  "auth": {
  "env_var": "",
  "type": "none"
},
  "cost": {
  "input_token_cost": 0,
  "output_token_cost": 0,
  "currency": "USD"
},
  "defaults": {
  "model": "qwen3_5_text-local-4096-32",
  "temperature": 0.7,
  "top_p": 1,
  "max_tokens": 512
},
  "endpoint": "http://127.0.0.1:18081/v1/chat/completions",
  "name": "sprout-local",
  "display_name": "Sprout Local (MLX)",
  "headers": {},
  "message_conversion": {
  "convert_tool_role_to_user": false,
  "include_tool_call_id": true,
  "reasoning_content_field": ""
},
  "models": {
  "default_context_limit": 8192,
  "default_model_patterns": [
  "qwen3_5_text-local-",
  "qwen3-local-"
],
  "supports_vision": false
},
  "retry": {
  "max_delay_ms": 15000,
  "retryable_errors": [
  "rate_limit_exceeded",
  "temporary_error",
  "timeout"
],
  "backoff_multiplier": 2,
  "base_delay_ms": 1000,
  "max_attempts": 2
}
}