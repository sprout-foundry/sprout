{
  "name": "cerebras",
  "endpoint": "https://api.cerebras.ai/v1/chat/completions",
  "auth": {
    "type": "bearer",
    "env_var": "CEREBRAS_API_KEY"
  },
  "headers": {},
  "defaults": {
    "model": "qwen-3.8-27b",
    "temperature": 1.0,
    "max_tokens": -1,
    "top_p": 0.95
  },
  "message_conversion": {
    "include_tool_call_id": true,
    "convert_tool_role_to_user": false,
    "reasoning_content_field": "reasoning"
  },
  "streaming": {
    "format": "sse",
    "chunk_timeout_ms": 300000,
    "done_marker": "[DONE]"
  },
  "models": {
    "default_context_limit": 65536,
    "model_info": [
      {
        "context_length": 131072,
        "description": "GPT OSS 120B on Cerebras wafer-scale hardware, served at roughly 3000 tokens per second. Supports text input and tool calling.",
        "id": "gpt-oss-120b",
        "input_cost": 0.35,
        "name": "GPT OSS 120B",
        "output_cost": 0.75,
        "tags": [
          "tools"
        ]
      },
      {
        "context_length": 65536,
        "description": "Qwen 3.8 27B on Cerebras wafer-scale hardware, served at roughly 1850 tokens per second. Supports text input and tool calling.",
        "id": "qwen-3.8-27b",
        "input_cost": 0.99,
        "name": "Qwen 3.8 27B",
        "output_cost": 1.49,
        "tags": [
          "tools"
        ]
      }
    ],
    "model_overrides": {
      "qwen-3.8-27b": 65536
    },
    "pattern_overrides": [],
    "supports_vision": false,
    "vision_model": "",
    "default_model": "qwen-3.8-27b",
    "available_models": []
  },
  "retry": {
    "max_attempts": 3,
    "base_delay_ms": 1000,
    "backoff_multiplier": 2.0,
    "max_delay_ms": 30000,
    "retryable_errors": [
      "rate_limit_exceeded",
      "temporary_error",
      "timeout"
    ]
  },
  "cost": {
    "input_token_cost": 0.99,
    "output_token_cost": 1.49,
    "currency": "USD"
  },
  "display_name": "Cerebras"
}
