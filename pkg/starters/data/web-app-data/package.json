{
  "name": "web-app-data",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit && vite build && vite build -c vite.worker.config.ts",
    "preview": "vite preview",
    "test": "vitest run -c vitest.config.ts && vitest run -c vitest.workers.config.ts",
    "db:migrate": "wrangler d1 migrations apply web-app-data-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply web-app-data-db --remote",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "ws": "8.21.0"
  }
}
