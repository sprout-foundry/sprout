%% design-mode — mode switching between Code and Design, design-rail
%% navigation, and the file handoff back to Code.
flowchart TD
  app-shell["app-shell — Code mode"]
  design-flows["design-flows — flows canvas"]
  design-screens["design-screens — screens browser"]
  editor["editor — Code mode file"]
  %% switch to Design mode from the top-left mode switcher
  app-shell --> design-flows
  %% select the Screens rail tab
  design-flows --> design-screens
  %% select the Flows rail tab
  design-screens --> design-flows
  %% open a wireframe's source file — handoff back to Code mode
  design-screens --> editor
  %% switch back to Code mode from the mode switcher
  design-flows --> app-shell
  editor --> app-shell
