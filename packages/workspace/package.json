{
  "name": "@sprout-foundry/workspace",
  "version": "1.0.0",
  "description": "Composition API for Sprout — the workspace, its spaces and views, for hosts that embed them",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/sprout-foundry/sprout.git",
    "directory": "packages/workspace"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/views.js",
    "dist/design.js",
    "dist/chunks/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && node scripts/bundle-dts.mjs",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@sprout/events": "file:../events",
    "@sprout/ui": "file:../ui"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
